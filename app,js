/* =========================================================
   AEGIS — Operations Command
   Application logic
   ========================================================= */

(() => {
  'use strict';

  // ---------- Storage keys ----------
  const STORAGE_KEY = 'aegis.v1.state';
  const SETTINGS_KEY = 'aegis.v1.settings';

  // ---------- State ----------
  const defaultState = {
    tasks: [],
  };

  const defaultSettings = {
    name: '',
    sound: false,
    scanline: true,
    focus: false,
  };

  let state = loadState();
  let settings = loadSettings();

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return structuredClone(defaultState);
      return JSON.parse(raw);
    } catch {
      return structuredClone(defaultState);
    }
  }

  function saveState() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function loadSettings() {
    try {
      const raw = localStorage.getItem(SETTINGS_KEY);
      if (!raw) return { ...defaultSettings };
      return { ...defaultSettings, ...JSON.parse(raw) };
    } catch {
      return { ...defaultSettings };
    }
  }

  function saveSettings() {
    localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
  }

  function uid() {
    return 'tsk_' + Math.random().toString(36).slice(2, 10);
  }

  function nowISO() {
    return new Date().toISOString();
  }

  function $(sel, root = document) {
    return root.querySelector(sel);
  }

  /**
   * Main setup sequence.
   * Forces the boot overlay to disappear after initialization.
   */
  function setup() {
    const bootOverlay = $('#boot');
    const bootStatus = $('#bootStatus');

    console.log('AEGIS: System Initializing...');

    // 1. Update status text for visual feedback
    setTimeout(() => {
      if (bootStatus) bootStatus.textContent = "ESTABLISHING SECURE CONNECTION...";
    }, 800);

    // 2. Clear the boot screen to reveal the app
    setTimeout(() => {
      if (bootStatus) bootStatus.textContent = "ACCESS GRANTED.";
      
      if (bootOverlay) {
        // Apply fade out styles
        bootOverlay.style.transition = 'opacity 0.8s ease, visibility 0.8s';
        bootOverlay.style.opacity = '0';
        bootOverlay.style.pointerEvents = 'none'; // Prevents the invisible div from blocking clicks
        
        // Fully remove from layout after fade
        setTimeout(() => {
          bootOverlay.style.display = 'none';
          bootOverlay.setAttribute('aria-hidden', 'true');
          console.log('AEGIS: Terminal Ready.');
        }, 800);
      }
    }, 2000);
  }

  function seedIfEmpty() {
    if (state.tasks.length > 0) return;

    const now = new Date();
    const in2h = new Date(now.getTime() + 2 * 3600 * 1000).toISOString();

    state.tasks = [
      {
        id: uid(),
        title: 'Review classified field report',
        notes: 'Cross-reference before briefing.',
        tier: 'urgent',
        when: in2h,
        completed: false,
        completedAt: null,
        createdAt: nowISO(),
        order: 0
      }
    ];

    saveState();
  }

  // Initialization trigger
  document.addEventListener('DOMContentLoaded', () => {
    seedIfEmpty();
    setup();
  });

})();

// Correct service worker registration
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./service-worker.js')
      .catch(err => console.error('SW registration failed:', err));
  });
}
