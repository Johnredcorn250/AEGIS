/* =========================================================
   AEGIS — Operations Command
   Application logic
   ========================================================= */

(() => {
  'use strict';

  // ---------- Storage keys ----------
  const STORAGE_KEY = 'aegis.v1.state';
  const SETTINGS_KEY = 'aegis.v1.settings';

  // ---------- State ----------
  const defaultState = { tasks: [] };
  const defaultSettings = { name: '', sound: false, scanline: true, focus: false };

  let state = loadState();
  let settings = loadSettings();

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : structuredClone(defaultState);
    } catch { return structuredClone(defaultState); }
  }

  function saveState() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }

  function loadSettings() {
    try {
      const raw = localStorage.getItem(SETTINGS_KEY);
      return raw ? { ...defaultSettings, ...JSON.parse(raw) } : { ...defaultSettings };
    } catch { return { ...defaultSettings }; }
  }

  function saveSettings() { localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); }

  function $ (sel) { return document.querySelector(sel); }

  /**
   * EMERGENCY BOOT REMOVAL
   * Physically deletes the overlay from the DOM after 2 seconds.
   */
  function setup() {
    const bootOverlay = document.getElementById('boot');
    const bootStatus = document.getElementById('bootStatus');

    console.log("AEGIS: Booting...");

    // Update status for visual feedback
    setTimeout(() => {
      if (bootStatus) bootStatus.textContent = "ESTABLISHING SECURE CONNECTION...";
    }, 700);

    // Final purge
    setTimeout(() => {
      if (bootStatus) bootStatus.textContent = "ACCESS GRANTED.";
      
      if (bootOverlay) {
        bootOverlay.style.opacity = '0';
        bootOverlay.style.pointerEvents = 'none';
        
        // Remove the element completely after the fade
        setTimeout(() => {
          bootOverlay.remove();
          console.log("AEGIS: Boot screen purged.");
        }, 600);
      }
    }, 2000);
  }

  function seedIfEmpty() {
    if (state.tasks.length > 0) return;
    state.tasks = [{
      id: 'tsk_' + Math.random().toString(36).slice(2, 10),
      title: 'Review classified field report',
      notes: 'Cross-reference before briefing.',
      tier: 'urgent',
      when: new Date(Date.now() + 7200000).toISOString(),
      completed: false,
      completedAt: null,
      createdAt: new Date().toISOString(),
      order: 0
    }];
    saveState();
  }

  // Handle both refresh and cold start
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { seedIfEmpty(); setup(); });
  } else {
    seedIfEmpty(); 
    setup();
  }
})();

// SW registration
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./service-worker.js')
      .then(reg => { if (reg.waiting) reg.waiting.postMessage({ type: 'SKIP_WAITING' }); })
      .catch(err => console.error('SW Error:', err));
  });
}
